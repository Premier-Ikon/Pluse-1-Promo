# Google Cloud Function trigger URL for the contact form
NEXT_PUBLIC_CONTACT_API_URL=https://us-west1-plus-one-promo.cloudfunctions.net/contactFormP1P

# Admin catalog API (order requests + products)
NEXT_PUBLIC_CATALOG_API_URL=https://us-west1-plus-one-promo.cloudfunctions.net/adminApiP1P

# Google Maps Places (address autocomplete for account profile)
# Restrict this key by HTTP referrer in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
